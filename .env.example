# Google OAuth - opret en app på https://console.cloud.google.com/
# Authoriserede redirect URIs:
#   Lokal: http://localhost:3000/auth/google
#   Produktion: https://dit-domæne.pages.dev/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Session krypteringsnøgle - minimum 32 tegn, brug f.eks.:
# node -e "console.log(crypto.randomBytes(32).toString('base64'))"
NUXT_SESSION_PASSWORD=

# NuxtHub - genereres automatisk ved deploy
# NUXT_HUB_PROJECT_KEY=
